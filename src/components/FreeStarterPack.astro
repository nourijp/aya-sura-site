---
// Free Starter Pack email capture — replaces the old generic
// "Get Club Updates" / "Keep Me Updated" pattern per v10 corrections.
// Client posts to /api/free-starter (see functions/api/free-starter.ts,
// a Cloudflare Pages Function). In EMAIL_MODE=preview that function
// validates syntax only and never sends a real email.
interface Props {
  formId?: string;
  buttonLabel?: string;
  eyebrow?: string;
  heading?: string;
  body?: string;
  successHref?: string;
  successMessage?: string;
}
const {
  formId = 'free-starter-pack',
  buttonLabel = 'Send Me the Free Adventure Sampler',
  eyebrow = 'Try Aya & Sura Free',
  heading = 'Not ready to join yet? Start with a free Aya & Sura Adventure Sampler.',
  body = "Get a short story preview, one coloring page and one story-connected activity delivered to your inbox. Confirm your email once, then the sampler is yours.",
  successHref = '/free/check-your-email/',
  successMessage = ''
} = Astro.props;
---
<div class="free-pack card" data-success-href={successHref} data-success-message={successMessage}>
  <p class="eyebrow" style="color:#fff2df;">{eyebrow}</p>
  <h2>{heading}</h2>
  <p>{body}</p>
  <form id={formId} class="free-pack-form" data-free-starter-form>
    <label class="visually-hidden" for={`${formId}-email`}>Email address</label>
    <div class="update-form-row">
      <input id={`${formId}-email`} type="email" name="email" placeholder="you@example.com" required />
      <button class="btn btn-primary" style="background:#fff9f0;color:var(--brand-deep);" type="submit">{buttonLabel}</button>
    </div>
    <p class="muted" style="font-size:.85rem;margin-top:.5rem;color:#fff2df;">We'll ask you to confirm your email first. You can unsubscribe at any time.</p>
    <p data-status role="status" style="font-size:.85rem;margin-top:.5rem;color:#fff2df;"></p>
  </form>
</div>

<style>
  .free-pack.card {
    background: var(--brand-deep);
    border-color: var(--brand-deep);
  }
  .free-pack h2 { color: #fff9f0; }
  .free-pack p { color: #fff2df; }
  .update-form-row { display: flex; flex-wrap: wrap; gap: .75rem; }
  input[type="email"] {
    flex: 1 1 220px;
    padding: .8em 1em;
    border-radius: 999px;
    border: 1px solid var(--line);
    font-size: 1rem;
  }
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }
</style>

<script>
  // Client-side handler for every Free Starter Pack form on the page.
  // Production note: the real Brevo double-opt-in call happens server-side
  // in functions/api/free-starter.ts — never add a Brevo API key here.
  document.querySelectorAll('[data-free-starter-form]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const el = form as HTMLFormElement;
      const wrapper = el.closest('[data-success-href]') as HTMLElement | null;
      const successHref = wrapper?.dataset.successHref || '/free/check-your-email/';
      const successMessage = wrapper?.dataset.successMessage || '';
      const status = el.querySelector('[data-status]') as HTMLElement | null;
      const emailInput = el.querySelector('input[type="email"]') as HTMLInputElement | null;
      const email = emailInput?.value?.trim() || '';

      const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailPattern.test(email)) {
        if (status) status.textContent = 'Please enter a valid email address.';
        return;
      }

      if (status) status.textContent = 'Sending…';

      try {
        const res = await fetch('/api/free-starter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, formId: el.id })
        });
        if (res.ok) {
          if (successMessage) {
            if (status) status.textContent = successMessage;
            el.reset();
          } else {
            window.location.href = successHref;
          }
          return;
        }
        if (status) status.textContent = "We couldn't send the confirmation email. Please try again.";
      } catch (err) {
        // Local `astro dev`/`preview` has no Cloudflare Functions runtime,
        // so this fetch will fail there even though the form logic is
        // correct. Fall back to the same confirmation route so the staging
        // flow can still be reviewed end-to-end.
        if (successMessage) {
          if (status) status.textContent = successMessage;
          el.reset();
        } else {
          window.location.href = successHref;
        }
      }
    });
  });
</script>
