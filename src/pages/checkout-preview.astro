---
import Layout from '../layouts/Layout.astro';
import { business } from '../config/business.ts';
import { routes } from '../config/routes.ts';
---
<Layout title="Checkout Preview" description="Staging checkout preview for the Aya & Sura Adventure Club — Founding Season.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Aya &amp; Sura Adventure Club</p>
      <h1>Aya &amp; Sura Adventure Club — Founding Season</h1>

      <div class="card" style="max-width:520px;margin-top:1.5rem;">
        <h3>Order summary</h3>
        <p class="muted">{business.foundingMonths} monthly digital Adventures · Founding Season</p>
        <p style="font-size:1.8rem;font-weight:800;color:var(--brand-deep);margin:.5rem 0;">${business.foundingPrice.toFixed(2)} total <span style="font-size:1rem;font-weight:600;color:var(--muted);">one-time payment</span></p>
        <ul>
          <li>3 monthly digital Aya &amp; Sura Adventure releases</li>
          <li>Story, activities, coloring pages and printable collectibles each month</li>
          <li>Month 1 arrives about {business.foundingDeliveryDelayDays} days after enrollment closes; Months 2 and 3 arrive monthly after that</li>
          <li>No automatic renewal</li>
        </ul>
      </div>

      <div class="card" style="max-width:520px;margin-top:1.5rem;background:#fff4e6;border-color:var(--brand-deep);">
        <h3>Staging checkout — payment disabled</h3>
        <p class="muted">This is a staging preview of the purchase flow. No payment is collected here. In production, this step hands off to a real WooCommerce checkout.</p>
        <p class="muted">Production checkout will collect:</p>
        <ul class="muted">
          <li>Email address</li>
          <li>Billing details and payment method</li>
          <li>Agreement to the site Terms</li>
        </ul>
        <button class="btn btn-primary" type="button" disabled aria-disabled="true">Payment disabled in local staging</button>
      </div>

      <div class="btn-row" style="margin-top:1.5rem;">
        <a class="btn btn-secondary" href={routes.club}>Back to Adventure Club</a>
      </div>
    </div>
  </section>
</Layout>
