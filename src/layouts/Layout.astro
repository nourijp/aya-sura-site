---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Aya & Sura — stories, games, activities and adventures created for Muslim kids. Staging site.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{title} · Aya & Sura</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/images/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/images/brand/favicon-64.png" />
    <link rel="apple-touch-icon" href="/images/brand/logo-mark-256.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <img
      src="/images/brand/corner-mascot.png"
      alt=""
      aria-hidden="true"
      class="corner-mascot"
      width="500"
      loading="lazy"
    />
  </body>
</html>

<style>
  .corner-mascot {
    display: none;
    position: fixed;
    left: -18px;
    bottom: -14px;
    width: 130px;
    height: auto;
    pointer-events: none;
    z-index: 10;
    filter: drop-shadow(0 6px 10px rgba(39,35,31,.15));
  }
  @media (min-width: 980px) {
    .corner-mascot { display: block; }
  }
</style>
