---
import Layout from '../layouts/Layout.astro';
import { business } from '../config/business.ts';
import { routes } from '../config/routes.ts';
---
<Layout title="Checkout Preview" description="Staging checkout preview for the Aya & Sura Founding Adventure Club.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Founding Adventure Club</p>
      <h1>Aya &amp; Sura Founding Adventure Club</h1>

      <div class="card" style="max-width:520px;margin-top:1.5rem;">
        <h3>Order summary</h3>
        <p class="muted">{business.foundingMonths} months · founding cohort</p>
        <p style="font-size:1.8rem;font-weight:800;color:var(--brand-deep);margin:.5rem 0;">${business.foundingPrice.toFixed(2)} <span style="font-size:1rem;font-weight:600;color:var(--muted);">one-time purchase</span></p>
        <ul>
          <li>Three monthly Aya &amp; Sura Adventure releases</li>
          <li>Story, activities, coloring pages and printable collectibles each month</li>
          <li>First release about {business.foundingDeliveryDelayDays} days after enrollment</li>
          <li>No automatic renewal</li>
        </ul>
      </div>

      <div class="card" style="max-width:520px;margin-top:1.5rem;background:#fff4e6;border-color:var(--brand-deep);">
        <h3>Staging checkout — payment disabled</h3>
        <p class="muted">This is a staging preview of the purchase flow. No payment is collected here. In production, this step hands off to a real WooCommerce checkout.</p>
        <p class="muted">Production checkout will collect:</p>
        <ul class="muted">
          <li>Email address</li>
          <li>Billing details and payment method</li>
          <li>Agreement to the site Terms</li>
        </ul>
        <button class="btn btn-primary" type="button" disabled aria-disabled="true">Staging Checkout — Payment Disabled</button>
      </div>

      <div class="btn-row" style="margin-top:1.5rem;">
        <a class="btn btn-secondary" href={routes.club}>Back to Adventure Club</a>
      </div>
    </div>
  </section>
</Layout>
