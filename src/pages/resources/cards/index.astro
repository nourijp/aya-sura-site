---
import Layout from '../../../layouts/Layout.astro';
---
<Layout title="Card Audio & Resources">
  <section class="section">
    <div class="container">
      <h1>Aya &amp; Sura Card Audio &amp; Resources</h1>
      <p>Already have an Aya &amp; Sura deck? Use the companion resources below to listen, practice and find game ideas for your cards.</p>
      <div class="grid grid-2" style="margin-top:1.5rem;">
        <div class="card">
          <h3>Quran Edition</h3>
          <p class="muted">Audio and companion resources for the Aya &amp; Sura Flashcards — Quran Edition.</p>
          <a class="btn btn-ghost" href="/resources/cards/quran-edition/">Open Quran Edition Resources</a>
        </div>
        <div class="card">
          <h3>Surah Edition</h3>
          <p class="muted">Audio and companion resources for the Aya &amp; Sura Deck — Surah Edition.</p>
          <a class="btn btn-ghost" href="/resources/cards/surah-edition/">Open Surah Edition Resources</a>
        </div>
      </div>
      <h2 style="margin-top:2rem;">Help</h2>
      <p>Scan not working or unsure which deck you have? <a href="/contact/">Contact us</a> and include a photo of the front of your deck.</p>
    </div>
  </section>
</Layout>
