---
import Layout from '../layouts/Layout.astro';
import { routes } from '../config/routes.ts';
---
<Layout title="Contact" description="Questions about an order, the cards, the Adventure Club, the app or anything else? Contact Aya & Sura.">
  <section class="section">
    <div class="container">
      <h1>How can we help?</h1>
      <p>Questions about an order, the cards, Adventure Club, the app or anything else Aya &amp; Sura? Send us a message and choose the topic that fits best.</p>

      <form
        class="card"
        style="max-width:640px;margin-top:1.5rem;"
        data-mock="true"
        onsubmit="event.preventDefault(); this.querySelector('[data-status]').textContent='Message received (staging preview) — no message was actually delivered. In production this form sends to the Aya & Sura support inbox.'; this.querySelector('[data-status]').hidden=false;"
      >
        <div class="grid" style="gap:1rem;">
          <label>Name (optional)
            <input type="text" name="name" />
          </label>
          <label>Email
            <input type="email" name="email" required />
          </label>
          <label>What can we help with?
            <select name="topic" id="contact-topic">
              <option>Order help</option>
              <option>Card Audio / QR resources</option>
              <option>Adventure Club</option>
              <option>Giving Thanks to Allah</option>
              <option>Aya &amp; Sura app</option>
              <option>School / organization</option>
              <option>Partnership / press</option>
              <option>Feedback</option>
              <option>Other</option>
            </select>
          </label>
          <label>Order number (if applicable)
            <input type="text" name="order_number" />
          </label>
          <label>Message
            <textarea name="message" required></textarea>
          </label>
          <label style="display:flex;flex-direction:row;align-items:flex-start;gap:.6rem;font-weight:400;">
            <input type="checkbox" name="ack" required style="width:auto;margin-top:.3rem;" />
            <span>I understand Aya &amp; Sura will use this information to respond to my request.</span>
          </label>
        </div>
        <button class="btn btn-primary" type="submit" style="margin-top:1.5rem;">Send Message</button>
        <p data-status class="muted" role="status" style="margin-top:.75rem;"></p>
      </form>
      <p class="muted" style="margin-top:1rem;">See our <a href={routes.privacy}>Privacy Policy</a>. This is a local staging form — no message is actually delivered until a real support inbox is connected.</p>
    </div>
  </section>
</Layout>

<style>
  label { display: grid; gap: .35rem; font-weight: 600; font-size: .9rem; }
  input, textarea, select {
    padding: .7em .9em;
    border-radius: var(--radius-small);
    border: 1px solid var(--line);
    font-family: inherit;
    font-size: 1rem;
  }
  textarea { min-height: 6em; }
</style>
