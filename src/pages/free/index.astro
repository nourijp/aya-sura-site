---
import Layout from '../../layouts/Layout.astro';
import MediaPlaceholder from '../../components/MediaPlaceholder.astro';
import FreeStarterPack from '../../components/FreeStarterPack.astro';
import { routes } from '../../config/routes.ts';
---
<Layout title="Free Adventure Sampler" description="Get a free Aya & Sura story preview, coloring page and activity by email.">
  <section class="section" style="padding-top:clamp(3rem, 8vw, 6rem);">
    <div class="container">
      <MediaPlaceholder label="FREE ADVENTURE SAMPLER — story page + coloring page + activity composite" ratio="wide" variant={2} />
    </div>
  </section>
  <section class="section section--deep">
    <div class="container">
      <FreeStarterPack formId="free-page-form" />
    </div>
  </section>
  <section class="section section--surface">
    <div class="container">
      <h2>Want more right away?</h2>
      <p>Families ready to join now can start with the Aya & Sura Adventure Club — Founding Season, or explore the current Quran Edition and Surah Edition card series.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={routes.club}>Join the Founding Season</a>
        <a class="btn btn-secondary" href={routes.cards}>Explore Cards &amp; Games</a>
      </div>
    </div>
  </section>
</Layout>
