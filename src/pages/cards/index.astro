---
import Layout from '../../layouts/Layout.astro';
import MediaPlaceholder from '../../components/MediaPlaceholder.astro';
import { routes } from '../../config/routes.ts';
---
<Layout title="Cards & Games">
  <section class="section">
    <div class="container">
      <h1>Cards made to play, listen and keep learning with.</h1>
      <p>Aya &amp; Sura currently has two Volume 1 card editions. Each is designed as a reusable family product rather than a one-time worksheet, with physical cards plus QR-linked supporting material and audio.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={routes.quranEdition}>Explore the Quran Edition</a>
        <a class="btn btn-secondary" href={routes.surahEdition}>Explore the Surah Edition</a>
      </div>
      <MediaPlaceholder label="CARDS HERO — both real deck boxes + sample cards" ratio="wide" variant={1} />
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <h2>Two card series. Built to grow.</h2>
      <div class="grid grid-2" style="margin-top:1.5rem;">
        <div class="card">
          <MediaPlaceholder label="Quran Edition — sample card faces and backs" ratio="wide" variant={1} />
          <span class="tag">Volume 1</span>
          <h3>Quran Edition — Volume 1</h3>
          <p class="muted">Build familiarity with Quran vocabulary through visual cards, listening and repeat play. Use the deck on its own, alongside the audio companion, or with simple games that make practice more active.</p>
          <a class="btn btn-ghost" href={routes.quranEdition}>View Quran Edition</a>
        </div>
        <div class="card">
          <MediaPlaceholder label="Surah Edition — sample card faces and backs" ratio="wide" variant={2} />
          <span class="tag">Volume 1</span>
          <h3>Surah Edition — Volume 1</h3>
          <p class="muted">Work through Al-Fatihah, Al-Ikhlas and Al-'Asr with a focused set of cards that helps children break the surahs into smaller pieces they can see, hear and revisit.</p>
          <a class="btn btn-ghost" href={routes.surahEdition}>View Surah Edition</a>
        </div>
      </div>
      <p class="muted" style="margin-top:1.5rem;">Volume 1 is the beginning of each series. Additional card content can expand the library over time as new sets are completed.</p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <h2>Turn the deck into a game.</h2>
      <div class="grid grid-4" style="margin-top:1.5rem;">
        <div class="card"><h3>Listen &amp; Find</h3><p class="muted">Play the audio and race to find the matching card.</p></div>
        <div class="card"><h3>Group Quiz</h3><p class="muted">Take turns drawing cards and trying the matching word or answer.</p></div>
        <div class="card"><h3>Self Quiz</h3><p class="muted">Use one side of the card as the prompt and the other to check yourself.</p></div>
        <div class="card"><h3>Matching &amp; Memory</h3><p class="muted">Use cards as a base for simple matching or memory-style play where appropriate.</p></div>
      </div>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container hero hero--split">
      <div>
        <h2>The cards do more after you scan them.</h2>
        <p>Selected cards connect to supporting audio and information through QR codes printed on the physical product. Those resources are part of the card experience, so existing QR links will continue to work as AyaSura.com changes.</p>
        <a class="btn btn-secondary" href={routes.cardResources}>Open Card Audio &amp; Resources</a>
      </div>
      <MediaPlaceholder label="Physical card + phone showing resource/audio page" ratio="wide" variant={3} />
    </div>
  </section>
</Layout>
