---
import Layout from '../../layouts/Layout.astro';
import MediaPlaceholder from '../../components/MediaPlaceholder.astro';
---
<Layout title="Meet Poji">
  <section class="section">
    <div class="container hero hero--split">
      <div>
        <h1>Meet Poji</h1>
        <p>Poji is Aya's little lion doll and one of the most recognizable companions in the Aya &amp; Sura world. To the people around Aya and Sura, Poji is a doll. Within the storytelling world, Poji can still carry personality, humor and emotional meaning without changing that rule.</p>
      </div>
      <MediaPlaceholder label="CHARACTER — Poji approved art" ratio="portrait" variant={3} />
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <h2>Small lion. Big presence.</h2>
      <p>Poji can appear in story scenes, coloring pages, activities and collectibles, giving younger children one more familiar face to look for each time they return to Aya &amp; Sura.</p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <h2>Find Poji</h2>
      <p class="muted">Coloring and activity content featuring Poji will link here once available.</p>
      <a class="btn btn-ghost" href="/adventure-club/">See the Adventure Club</a>
    </div>
  </section>
</Layout>
