---
import Layout from '../../layouts/Layout.astro';
import MediaPlaceholder from '../../components/MediaPlaceholder.astro';
import { routes } from '../../config/routes.ts';

const cardImgStyle = 'width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:var(--radius-card);background:var(--brand-soft);margin-bottom:1rem;';
---
<Layout title="Characters">
  <section class="section">
    <div class="container">
      <h1>Meet the Aya &amp; Sura world</h1>
      <p>Aya and Sura are siblings, which means they can be teammates one minute and completely disagree the next. Their differences give stories room for humor, mistakes, questions and growth. Poji—the little lion doll who is rarely far from Aya—comes along for the ride. As the world expands, more friends and familiar faces can join them.</p>
    </div>
  </section>

  <section class="section section--surface">
    <div class="container">
      <h2>The center of the world</h2>
      <div class="grid grid-2" style="margin-top:2rem;">
        <div class="card">
          <img src="/images/characters/aya-meet-scene.jpg" alt="Aya laughing and pointing while riding a jumping sheep" style={cardImgStyle} width="700" loading="lazy" />
          <h3>Aya</h3>
          <p class="muted">Energetic, expressive and often the first to jump into an idea.</p>
          <a class="btn btn-ghost" href={routes.characterAya}>Meet Aya</a>
        </div>
        <div class="card">
          <img src="/images/characters/sura-solo.png" alt="Sura standing calmly with his hands together" style={`${cardImgStyle}object-fit:contain;`} width="506" loading="lazy" />
          <h3>Sura</h3>
          <p class="muted">Thoughtful, observant and more likely to stop and think before jumping in.</p>
          <a class="btn btn-ghost" href={routes.characterSura}>Meet Sura</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Always nearby</h2>
      <div class="card" style="max-width:320px;margin-top:1.5rem;">
        <MediaPlaceholder label="CHARACTER — Poji approved art" ratio="portrait" variant={3} />
        <h3>Poji</h3>
        <p class="muted">Aya's little lion doll and a constant companion in the Aya &amp; Sura world.</p>
        <a class="btn btn-ghost" href={routes.characterPoji}>Meet Poji</a>
      </div>
    </div>
  </section>

  <!-- Friends & Family: name + real art + one short, truthful, non-invented
       line per entry. No personality/backstory details are added beyond
       what's established — see docs/OWNER_DECISIONS.md. -->
  <section class="section section--soft">
    <div class="container">
      <h2>Friends &amp; family</h2>
      <p>Aya &amp; Sura is not built around a single one-off story. More friends and familiar faces join the world as their stories are ready to share.</p>
      <div class="grid grid-2" style="margin-top:1.5rem;">
        <div class="card">
          <img src="/images/characters/isa.png" alt="Isa" style={`${cardImgStyle}object-fit:contain;`} width="321" loading="lazy" />
          <h3>Isa</h3>
          <p class="muted">One of the familiar faces from the wider Aya &amp; Sura cast.</p>
        </div>
        <div class="card">
          <img src="/images/characters/nao.png" alt="Nao" style={`${cardImgStyle}object-fit:contain;`} width="539" loading="lazy" />
          <h3>Nao</h3>
          <p class="muted">One of the familiar faces from the wider Aya &amp; Sura cast.</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
