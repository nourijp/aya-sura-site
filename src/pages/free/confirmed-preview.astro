---
import Layout from '../../layouts/Layout.astro';
import { routes } from '../../config/routes.ts';
---
<Layout title="Email Confirmed (Preview)" description="Staging preview of the Free Adventure Sampler email confirmation.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Staging preview</p>
      <h1>Email confirmed. Your free Adventure Sampler is ready.</h1>
      <p>This is a local staging preview of the confirmation state — no real subscriber was created and no real email was sent. In production, clicking the real confirmation link lands here and the Adventure Sampler is delivered by email.</p>
      <div class="btn-row" style="margin-top:1.5rem;">
        <a class="btn btn-primary" href="/free/starter-pack-preview/">See the Adventure Sampler Preview →</a>
        <a class="btn btn-secondary" href={routes.home}>Back to Home</a>
      </div>
    </div>
  </section>
</Layout>
