---
import Layout from '../layouts/Layout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import UpdateForm from '../components/UpdateForm.astro';
import { commerce, foundingClub, book } from '../config/commerce.ts';
---
<Layout title="Grow up with Aya & Sura">
  <!-- HERO -->
  <section class="section">
    <div class="container hero hero--split">
      <div>
        <p class="eyebrow">Stories • Play • Learning</p>
        <h1>Grow up with Aya &amp; Sura.</h1>
        <p>Meet a brother-and-sister duo at the center of stories, games, activities and adventures made for Muslim kids. Read with them, play with them, learn alongside them—and watch their world grow.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/characters/">Explore Aya &amp; Sura</a>
          <a class="btn btn-secondary" href="/club/">See the Adventure Club</a>
        </div>
      </div>
      <MediaPlaceholder
        label="HERO: Aya + Sura + Poji together in an active, everyday/adventure scene"
        ratio="wide"
        variant={1}
      />
    </div>
  </section>

  <!-- A WORLD TO READ, PLAY AND EXPLORE -->
  <section class="section section--surface">
    <div class="container">
      <h2>More than one story. More than one way to play.</h2>
      <p>Aya &amp; Sura is being built as a world children can return to—in books, cards, activities, digital adventures and the Aya &amp; Sura app. Start wherever your family likes, then keep exploring.</p>
      <div class="grid grid-4" style="margin-top:2rem;">
        <div class="card">
          <h3>Read</h3>
          <p><strong>Stories children can come back to.</strong></p>
          <p class="muted">Follow Aya, Sura and their friends through everyday moments, family life, questions, mistakes and discoveries.</p>
          <a class="btn btn-ghost" href="/books/">Explore Stories &amp; Books</a>
          <MediaPlaceholder label="BOOK/STORY — open illustrated spread" ratio="card" variant={2} note="" />
        </div>
        <div class="card">
          <h3>Play</h3>
          <p><strong>Cards that turn learning into a game.</strong></p>
          <p class="muted">Use Aya &amp; Sura cards for matching, listening, memory games, self-quizzing and family play.</p>
          <a class="btn btn-ghost" href="/cards/">Explore Cards &amp; Games</a>
          <MediaPlaceholder label="CARDS — deck and several cards in play" ratio="card" variant={3} />
        </div>
        <div class="card">
          <h3>Join</h3>
          <p><strong>A new adventure to look forward to.</strong></p>
          <p class="muted">The Aya &amp; Sura Adventure Club is designed around new stories, activities, coloring pages and collectibles released as an ongoing experience.</p>
          <a class="btn btn-ghost" href="/club/">See the Adventure Club</a>
          <MediaPlaceholder label="CLUB — monthly digital pack composite" ratio="card" variant={4} />
        </div>
        <div class="card">
          <h3>App</h3>
          <p><strong>Bring the world with you.</strong></p>
          <p class="muted">The Aya &amp; Sura app is being built to connect stories, cards, audio and interactive play in one place.</p>
          <a class="btn btn-ghost" href="/app/">Explore the App</a>
          <MediaPlaceholder label="APP — phone/tablet showing real app screen" ratio="card" variant={1} />
        </div>
      </div>
    </div>
  </section>

  <!-- MEET THE CHARACTERS -->
  <section class="section">
    <div class="container">
      <h2>Meet Aya, Sura and Poji</h2>
      <p>The products may change. The characters are what tie the world together. Aya and Sura are siblings with different personalities, different ways of looking at things, and plenty to learn from each other along the way. And Poji is never far behind.</p>
      <div class="grid grid-3" style="margin-top:2rem;">
        <div class="card">
          <MediaPlaceholder label="CHARACTER — Aya full-body approved art" ratio="portrait" variant={1} />
          <h3>Aya</h3>
          <p class="muted">Bold, expressive and ready to jump into the next idea.</p>
          <a class="btn btn-ghost" href="/characters/aya/">Meet Aya</a>
        </div>
        <div class="card">
          <MediaPlaceholder label="CHARACTER — Sura full-body approved art" ratio="portrait" variant={2} />
          <h3>Sura</h3>
          <p class="muted">Thoughtful, observant and usually a little more cautious than his sister.</p>
          <a class="btn btn-ghost" href="/characters/sura/">Meet Sura</a>
        </div>
        <div class="card">
          <MediaPlaceholder label="CHARACTER — Poji approved art" ratio="portrait" variant={3} />
          <h3>Poji</h3>
          <p class="muted">Aya's little lion doll and a familiar part of the siblings' adventures.</p>
          <a class="btn btn-ghost" href="/characters/poji/">Meet Poji</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ADVENTURE CLUB FEATURE -->
  <section class="section section--deep">
    <div class="container hero hero--split">
      <div>
        <p class="eyebrow" style="color:#fff2df;">{foundingClub.live ? 'Founding Families' : 'Coming Next'}</p>
        <h2>One new story. One new theme. A month of ways to play.</h2>
        <p>We're developing the Aya &amp; Sura Adventure Club as an ongoing experience for families who want more than a single book or deck. Each adventure is designed to begin with a story and expand into activities children can color, solve, collect and enjoy together.</p>
        <ul>
          <li>A new illustrated Aya &amp; Sura story</li>
          <li>Printable activities and puzzles</li>
          <li>Coloring pages built from the same adventure</li>
          <li>A collectible card, badge or surprise</li>
          <li>A short guide for parents</li>
          <li>Optional app extras as the experience grows</li>
        </ul>
        <div class="btn-row">
          <a class="btn btn-primary" style="background:#fff9f0;color:var(--brand-deep);" href="/club/">
            {foundingClub.live ? 'Join the Founding Adventure Club' : 'See How the Club Works'}
          </a>
        </div>
      </div>
      <MediaPlaceholder label="CLUB COMPOSITE — story pages + coloring + activity + cards + parent page + app screen" ratio="wide" variant={4} />
    </div>
  </section>

  <!-- AVAILABLE NOW -->
  <section class="section section--surface">
    <div class="container">
      <h2>Start with the cards</h2>
      <p>Aya &amp; Sura began building their learning world through physical flashcards. Two decks are currently available, each with a different way to explore Quran vocabulary and surahs.</p>
      <div class="grid grid-2" style="margin-top:2rem;">
        <div class="card">
          <MediaPlaceholder label="PRODUCT PHOTO — Quran Edition deck + cards spread" ratio="card" variant={1} />
          <h3>Aya &amp; Sura Flashcards — Quran Edition</h3>
          <p class="muted">A colorful deck designed to help children become more familiar with Quran vocabulary through visual recognition, listening and play.</p>
          <a class="btn btn-ghost" href="/cards/quran-edition/">See the Quran Edition</a>
        </div>
        <div class="card">
          <MediaPlaceholder label="PRODUCT PHOTO — Surah Edition deck + cards spread" ratio="card" variant={2} />
          <h3>Aya &amp; Sura Deck — Surah Edition</h3>
          <p class="muted">A focused deck built around Al-Fatihah, Al-Ikhlas and Al-'Asr, with cards designed to help children work through the surahs piece by piece.</p>
          <a class="btn btn-ghost" href="/cards/surah-edition/">See the Surah Edition</a>
        </div>
      </div>
    </div>
  </section>

  <!-- BOOK COMING NEXT -->
  <section class="section">
    <div class="container hero hero--split">
      <MediaPlaceholder label="BOOK COVER — Giving Thanks to Allah (final cover when available)" ratio="portrait" variant={3} />
      <div>
        <p class="eyebrow">In Development</p>
        <h2>A new Aya &amp; Sura children's book is on the way.</h2>
        <p>Aya and Sura are moving from cards into longer-form stories. Our next children's book is nearing completion and will bring the characters into a warm illustrated story made for family reading.</p>
        <h3>Giving Thanks to Allah</h3>
        <p class="muted">A gentle Aya &amp; Sura story about family, gratitude and noticing the good things around us.</p>
        {book.status === 'coming-soon' && <UpdateForm heading="Get Book Updates" body="Coming soon — join the book update list." buttonLabel="Get Book Updates" formId="home-book-updates" />}
      </div>
    </div>
  </section>

  <!-- MADE FOR REAL FAMILY LIFE -->
  <section class="section section--soft">
    <div class="container">
      <h2>Meaningful doesn't have to feel like homework.</h2>
      <p>Aya &amp; Sura is designed around things children already enjoy—stories, characters, games, coloring, collecting and asking questions. Learning can be part of the experience without turning every moment into a lesson.</p>
      <div class="grid grid-3" style="margin-top:2rem;">
        <div class="card">
          <h3>Familiar Muslim characters</h3>
          <p class="muted">Children get to spend time with characters whose family and Muslim identity are simply part of their world.</p>
        </div>
        <div class="card">
          <h3>Multiple ways to engage</h3>
          <p class="muted">Read together, play a card game, listen to audio, print an activity or open the app.</p>
        </div>
        <div class="card">
          <h3>Built for parents too</h3>
          <p class="muted">Activities are designed to be understandable and usable without requiring parents to prepare an entire lesson plan.</p>
        </div>
      </div>
      <MediaPlaceholder label="LIFESTYLE ART — family/children using Aya & Sura content in an everyday setting" ratio="wide" variant={2} note="" />
    </div>
  </section>

  <!-- FAMILY PROOF -->
  <section class="section section--surface">
    <div class="container">
      <h2>Built with families, not just for them.</h2>
      <p>We are reconnecting with families who have already used Aya &amp; Sura products so we can learn what children actually enjoyed, what parents found useful and what we should build next.</p>
      <a class="btn btn-secondary" href="/feedback/">Already own Aya &amp; Sura cards? Share your experience</a>
    </div>
  </section>

  <!-- EXTENDED WORLD -->
  <section class="section">
    <div class="container hero hero--split">
      <div>
        <h2>Part of a bigger world of Muslim characters</h2>
        <p>Aya &amp; Sura grew from the creative world behind Muslim Manga. As the children's line expands, familiar faces from that wider world may appear in Aya &amp; Sura stories and activities in a style made for younger readers. You never need to know the older stories to enjoy Aya &amp; Sura—their world stands on its own.</p>
        <a class="btn btn-ghost" href="/about/">About Aya &amp; Sura</a>
      </div>
      <MediaPlaceholder label="EXTENDED WORLD — Aya & Sura foreground with subtle guest-character silhouettes/art" ratio="wide" variant={4} />
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section section--deep">
    <div class="container">
      <h2>Come grow with us.</h2>
      <p>Start with the cards, follow the next story, or join us as Aya &amp; Sura grows into a bigger world of things to read, play and discover.</p>
      <div class="btn-row">
        <a class="btn btn-primary" style="background:#fff9f0;color:var(--brand-deep);" href="/characters/">Explore Aya &amp; Sura</a>
        <a class="btn btn-secondary" style="background:transparent;color:#fff9f0;border-color:#fff9f0;" href={commerce.shopBase} rel="noopener">Shop the Cards</a>
      </div>
    </div>
  </section>
</Layout>
