---
import QrShell from '../../components/qr/QrShell.astro';
import html from '../../content/legacy/games.html?raw';
// the legacy page repeated its own title as the first <h2>; the shell supplies the <h1>
const body = html.replace(/^\s*<h2>[\s\S]*?<\/h2>\s*/, '');
---
<QrShell
  title="Game ideas"
  eyebrow="Aya & Sura Cards"
  description="Game ideas for playing with your Aya & Sura flashcards: Karuta, Round About, Solo and the Numbers Game."
  back={{ href: '/qr/cards/', label: 'Back to main' }}
>
  <div class="legacy-content" set:html={body} />
</QrShell>
