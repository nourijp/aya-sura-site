---
import Layout from '../layouts/Layout.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import FreeStarterPack from '../components/FreeStarterPack.astro';
import { commerce, book } from '../config/commerce.ts';
import { business, getFoundingCheckoutUrl } from '../config/business.ts';
import { routes } from '../config/routes.ts';
---
<Layout title="Grow up with Aya & Sura">
  <!-- HERO -->
  <section class="section">
    <div class="container hero hero--split">
      <div>
        <p class="eyebrow">Stories • Play • Faith • Learning</p>
        <h1>Grow up with Aya &amp; Sura.</h1>
        <p>Meet a brother-and-sister duo at the center of stories, games and adventures made for Muslim kids. Read with them, play with them, meet their friends and return to a world that grows with your family.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={routes.club}>Explore the Adventure Club</a>
          <a class="btn btn-secondary" href={routes.characters}>Meet the Characters</a>
        </div>
        <p class="muted" style="margin-top:.75rem;font-size:.85rem;">Founding Season · {business.foundingMonths} monthly digital Adventures · ${business.foundingPrice.toFixed(2)} total</p>
      </div>
      <MediaPlaceholder
        label="HERO: Aya + Sura + Poji together, with hints of the wider cast"
        ratio="wide"
        variant={1}
      />
    </div>
  </section>

  <!-- AYA & SURA ADVENTURE CLUB FEATURED SECTION -->
  <section class="section section--deep">
    <div class="container hero hero--split">
      <div>
        <p class="eyebrow" style="color:#fff2df;">AYA &amp; SURA ADVENTURE CLUB</p>
        <span class="tag" style="background:#fff9f0;color:var(--brand-deep);">FOUNDING SEASON</span>
        <h2>Three months. Three new adventures. One world to keep coming back to.</h2>
        <p>Join the first Aya &amp; Sura Adventure Club season for ${business.foundingPrice.toFixed(2)} total. Each month begins with a short illustrated story and expands into activities, coloring, puzzles, character moments and a family connection.</p>
        <div class="grid grid-3" style="margin:1.5rem 0;">
          <div class="card"><span class="tag">Month 1</span><p class="muted">First adventure arrives about {business.foundingDeliveryDelayDays} days after founding enrollment.</p></div>
          <div class="card"><span class="tag">Month 2</span><p class="muted">A new story and activity pack, about one month later.</p></div>
          <div class="card"><span class="tag">Month 3</span><p class="muted">The final founding-season adventure, about one month later.</p></div>
        </div>
        <div class="btn-row">
          <a class="btn btn-primary" style="background:#fff9f0;color:var(--brand-deep);" href={routes.club}>Join the Founding Season — ${business.foundingPrice.toFixed(2)}</a>
        </div>
        <p class="muted" style="color:#fff2df;">One-time payment. No automatic renewal.</p>
      </div>
      <MediaPlaceholder label="CLUB COMPOSITE — story cover + illustrated spread + coloring page + activity/puzzle + family page" ratio="wide" variant={4} />
    </div>
  </section>

  <!-- EXPLORE THE WORLD — VISUAL BENTO -->
  <section class="section section--surface">
    <div class="container">
      <h2>More than one story. More than one way into the world.</h2>
      <style>
        .bento-img {
          width: 100%;
          aspect-ratio: 16 / 9;
          object-fit: cover;
          border-radius: var(--radius-card);
        }
      </style>
      <div class="grid grid-2" style="margin-top:2rem;">
        <div class="card bento-tile">
          <img
            src="/images/books/aya-sura-library.jpg"
            alt="Aya and Sura together in a room lined with bookshelves"
            class="bento-img"
            width="1400"
            loading="lazy"
          />
          <h3>Read their adventures.</h3>
          <p class="muted">Follow Aya, Sura and their friends through stories about family, friendship, faith, curiosity and growing up.</p>
          <a class="btn btn-ghost" href={routes.stories}>Explore Stories</a>
        </div>
        <div class="card bento-tile">
          <MediaPlaceholder label="CARDS — deck and cards in play" ratio="wide" variant={3} />
          <h3>Play, listen and learn.</h3>
          <p class="muted">Use the Quran Edition and Surah Edition cards for matching, memory games, listening and family play.</p>
          <a class="btn btn-ghost" href={routes.cards}>Explore Cards &amp; Games</a>
        </div>
        <div class="card bento-tile bento-tile--wide">
          <MediaPlaceholder label="CLUB — monthly digital pack composite" ratio="wide" variant={4} />
          <h3>A new adventure every month.</h3>
          <p class="muted">Join the Aya &amp; Sura Adventure Club Founding Season for three story-led monthly releases with activities, coloring and bonus printable extras that can vary by issue.</p>
          <span class="tag">3 months · ${business.foundingPrice.toFixed(2)}</span>
          <div><a class="btn btn-ghost" href={routes.club}>Join the Founding Season</a></div>
        </div>
        <div class="card bento-tile">
          <MediaPlaceholder label="APP — phone/tablet showing real app screen" ratio="wide" variant={1} />
          <h3>Bring your card experience to the app.</h3>
          <p class="muted">The Aya &amp; Sura app extends the flashcard experience with digital support, audio and interactive tools.</p>
          <a class="btn btn-ghost" href={routes.app}>Explore the App</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CHARACTER WORLD -->
  <section class="section">
    <div class="container">
      <h2>Meet the Aya &amp; Sura world.</h2>
      <p>Aya and Sura are the heart of the brand, but their stories are shaped by siblings, friends, family and the people they meet along the way. Different characters can take the lead when the story calls for it.</p>
      <div class="grid grid-3" style="margin-top:2rem;">
        <div class="card">
          <MediaPlaceholder label="CHARACTER — Aya full-body approved art" ratio="portrait" variant={1} />
          <h3>Aya</h3>
          <p class="muted">Bold, expressive and ready to jump into the next idea.</p>
          <a class="btn btn-ghost" href={routes.characterAya}>Meet Aya</a>
        </div>
        <div class="card">
          <MediaPlaceholder label="CHARACTER — Sura full-body approved art" ratio="portrait" variant={2} />
          <h3>Sura</h3>
          <p class="muted">Thoughtful, observant and usually a little more cautious than his sister.</p>
          <a class="btn btn-ghost" href={routes.characterSura}>Meet Sura</a>
        </div>
        <div class="card">
          <MediaPlaceholder label="CHARACTER — Poji approved art" ratio="portrait" variant={3} />
          <h3>Poji</h3>
          <p class="muted">Aya's little lion doll and a familiar part of the siblings' adventures.</p>
          <a class="btn btn-ghost" href={routes.characterPoji}>Meet Poji</a>
        </div>
      </div>
      <div style="margin-top:1.5rem;"><a class="btn btn-secondary" href={routes.characters}>Meet All the Characters</a></div>
    </div>
  </section>

  <!-- AVAILABLE NOW — TWO CARD EDITIONS -->
  <section class="section section--surface">
    <div class="container">
      <h2>Available now: two card series</h2>
      <p>Aya &amp; Sura began building their learning world through physical flashcards. Two Volume 1 editions are available now, each with a different way to explore Quran vocabulary and surahs.</p>
      <div class="grid grid-2" style="margin-top:2rem;">
        <div class="card">
          <MediaPlaceholder label="PRODUCT PHOTO — Quran Edition deck + cards spread" ratio="wide" variant={1} />
          <span class="tag">Volume 1</span>
          <h3>Quran Edition — Volume 1</h3>
          <p class="muted">A colorful deck designed to help children become more familiar with Quran vocabulary through visual recognition, listening and play.</p>
          <a class="btn btn-ghost" href={routes.quranEdition}>See the Quran Edition</a>
        </div>
        <div class="card">
          <MediaPlaceholder label="PRODUCT PHOTO — Surah Edition deck + cards spread" ratio="wide" variant={2} />
          <span class="tag">Volume 1</span>
          <h3>Surah Edition — Volume 1</h3>
          <p class="muted">A focused deck built around Al-Fatihah, Al-Ikhlas and Al-'Asr, with cards designed to help children work through the surahs piece by piece.</p>
          <a class="btn btn-ghost" href={routes.surahEdition}>See the Surah Edition</a>
        </div>
      </div>
    </div>
  </section>

  <!-- GIVING THANKS TO ALLAH SPOTLIGHT -->
  <section class="section">
    <div class="container hero hero--split">
      <MediaPlaceholder label="BOOK COVER — Giving Thanks to Allah (final cover when available)" ratio="portrait" variant={3} />
      <div>
        <p class="eyebrow">In Development</p>
        <h2>Giving Thanks to Allah</h2>
        <p>A gentle Aya &amp; Sura story about family, gratitude and noticing the good things around us. Aya and Sura are moving from cards into longer-form stories, and this book is nearing completion.</p>
        <a class="btn btn-ghost" href={routes.book}>Read More About the Book</a>
      </div>
    </div>
  </section>

  <!-- MUSLIM CHILDHOOD / BRAND WORLDVIEW -->
  <section class="section section--soft">
    <div class="container">
      <h2>Muslim childhood is full of stories.</h2>
      <p>Faith is not a separate subject in Aya and Sura's lives. It can show up in how they greet people, give thanks to Allah, celebrate, help their family, care for a friend, visit a new place or make a difficult choice. Some adventures will be explicitly about Islamic moments. Others will simply let Muslim kids see a world where being Muslim is already normal.</p>
      <img
        src="/images/brand/dua-hands.png"
        alt="Open hands raised in dua"
        class="dua-art"
        width="1290"
        loading="lazy"
      />
      <style>
        .dua-art {
          width: 100%;
          max-width: 480px;
          aspect-ratio: 16 / 9;
          object-fit: contain;
          object-position: left center;
          margin: 0;
          border-radius: var(--radius-card);
          background:
            radial-gradient(circle at 50% 30%, rgba(255,255,255,.6), transparent 60%),
            linear-gradient(160deg, var(--accent-soft), var(--brand-soft));
        }
      </style>
      <div class="grid grid-3" style="margin-top:1.5rem;">
        <div class="card"><h3>Faith &amp; Values</h3></div>
        <div class="card"><h3>Family &amp; Friends</h3></div>
        <div class="card"><h3>Curiosity &amp; Adventure</h3></div>
      </div>
    </div>
  </section>

  {business.socialProofEnabled && (
    <section class="section section--surface">
      <div class="container">
        <h2>What families are saying</h2>
        <!-- Rendered only once real, approved parent quotes exist (business.socialProofEnabled). -->
      </div>
    </section>
  )}

  <!-- FREE STARTER PACK -->
  <section class="section section--deep">
    <div class="container">
      <FreeStarterPack />
    </div>
  </section>
</Layout>
