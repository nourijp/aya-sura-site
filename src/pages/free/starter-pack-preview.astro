---
import Layout from '../../layouts/Layout.astro';
import MediaPlaceholder from '../../components/MediaPlaceholder.astro';
import { routes } from '../../config/routes.ts';
---
<Layout title="Adventure Sampler Preview" description="Preview of the Free Adventure Sampler contents.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Preview</p>
      <h1>Here's what's inside the Free Adventure Sampler.</h1>
      <p>This page previews what a family receives after confirming their email. In production, these files are attached to or linked from the confirmation email itself.</p>
      <div class="grid grid-3" style="margin-top:2rem;">
        <div class="card">
          <MediaPlaceholder label="Free Adventure Sampler — short illustrated story preview" ratio="card" variant={1} />
          <h3>Story preview</h3>
          <p class="muted">A short illustrated Aya &amp; Sura story preview to read together.</p>
        </div>
        <div class="card">
          <MediaPlaceholder label="Free Adventure Sampler — coloring page" ratio="card" variant={2} />
          <h3>Coloring page</h3>
          <p class="muted">One printable coloring page from the story.</p>
        </div>
        <div class="card">
          <MediaPlaceholder label="Free Adventure Sampler — story-connected activity" ratio="card" variant={3} />
          <h3>Story-connected activity</h3>
          <p class="muted">A simple activity tied to the story you just read.</p>
        </div>
      </div>
      <div class="btn-row" style="margin-top:2rem;">
        <a class="btn btn-primary" href={routes.club}>Join the Founding Season</a>
        <a class="btn btn-secondary" href={routes.home}>Back to Home</a>
      </div>
    </div>
  </section>
</Layout>
