---
import Layout from '../layouts/Layout.astro';
import { routes } from '../config/routes.ts';
---
<Layout title="Feedback">
  <section class="section">
    <div class="container">
      <h1>Already used Aya &amp; Sura with your family?</h1>
      <p>We are reconnecting with families who have already used Aya &amp; Sura products so we can learn what children actually enjoyed, what parents found useful and what we should build next. Honest feedback is more valuable than praise.</p>

      <form class="card" style="max-width:640px;margin-top:1.5rem;" data-feedback-form>
        <div class="grid" style="gap:1rem;">
          <label>Name (optional)
            <input type="text" name="name" />
          </label>
          <label>Email
            <input type="email" name="email" required />
          </label>
          <label>Product used
            <select name="product">
              <option>Quran Edition — Volume 1</option>
              <option>Surah Edition — Volume 1</option>
              <option>Aya &amp; Sura app</option>
              <option>Giving Thanks to Allah / preview</option>
              <option>Other</option>
            </select>
          </label>
          <label>Child age range
            <select name="age_range">
              <option>2–4</option>
              <option>5–6</option>
              <option>7–8</option>
              <option>9–10</option>
              <option>11–12</option>
              <option>Prefer not to say</option>
            </select>
          </label>
          <label>What did your child enjoy most?
            <textarea name="enjoyed"></textarea>
          </label>
          <label>Did you use the QR/audio?
            <select name="used_audio"><option>Yes</option><option>No</option><option>Not sure</option></select>
          </label>
          <label>Did you try any card games?
            <select name="tried_games"><option>Yes</option><option>No</option></select>
          </label>
          <label>What was confusing or could be better?
            <textarea name="confusing"></textarea>
          </label>
          <label>What would you like Aya &amp; Sura to make next?
            <textarea name="next"></textarea>
          </label>
          <label style="display:flex;flex-direction:row;align-items:flex-start;gap:.6rem;font-weight:400;">
            <input type="checkbox" name="contact_ok" style="width:auto;margin-top:.3rem;" />
            <span>You may contact me about this feedback.</span>
          </label>
          <label style="display:flex;flex-direction:row;align-items:flex-start;gap:.6rem;font-weight:400;">
            <input type="checkbox" name="quote_ok" style="width:auto;margin-top:.3rem;" />
            <span>You may contact me to ask whether part of my feedback can be quoted publicly.</span>
          </label>
        </div>
        <button class="btn btn-primary" type="submit" style="margin-top:1.5rem;">Share Your Experience</button>
        <p data-status class="muted" role="status" style="margin-top:.75rem;"></p>
      </form>
      <p class="muted" style="margin-top:1rem;">We do not ask for your child's name. Checking the quote box only means we may ask permission later — we never publish an exact quote without sending it to you for approval first. See our <a href={routes.privacy}>Privacy Policy</a>.</p>
    </div>
  </section>
</Layout>

<script>
  const form = document.querySelector('[data-feedback-form]') as HTMLFormElement | null;
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const status = form.querySelector('[data-status]') as HTMLElement | null;
    if (status) {
      status.textContent = "Thank you — this is exactly the kind of feedback that helps shape what we build next. This preview build doesn't save submissions yet, so please also reach us directly if you'd like a reply.";
    }
  });
</script>

<style>
  label { display: grid; gap: .35rem; font-weight: 600; font-size: .9rem; }
  input, textarea, select {
    padding: .7em .9em;
    border-radius: var(--radius-small);
    border: 1px solid var(--line);
    font-family: inherit;
    font-size: 1rem;
  }
  textarea { min-height: 5em; }
</style>
